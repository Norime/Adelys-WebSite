@using Adelys_WebSite.ViewModels;
@model HomeSlideFormViewModel
@{
    bool isEdit = Model.Id != null;
    string action = isEdit ? "Modifier" : "Ajouter";
    ViewData["Title"] = isEdit ? "Modifier une image du carrousel" : "Ajouter une image au carrousel";
    <link rel="stylesheet" href="~/css/account.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/carousel.css" asp-append-version="true" />
}

<section class="account-panel account-panel-wide">
    <h1>@ViewData["Title"]</h1>
    <form class="carousel-form" asp-controller="Carousel" asp-action="@action" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
        <div class="account-field">
            <label asp-for="Image"></label>
            @if (Model.CurrentImageUrl != null)
            {
                <img class="carousel-form-current" src="@Model.CurrentImageUrl" alt="Image actuelle" />
            }
            <input asp-for="Image" type="file" accept="image/jpeg,image/png,image/gif,image/webp" />
            <span class="carousel-hint">@(isEdit ? "Laisse vide pour garder l'image actuelle. " : "")Format paysage conseillé, JPEG, PNG, GIF ou WebP, 10 Mo maximum.</span>
            <span asp-validation-for="Image" class="account-error"></span>
        </div>
        <div class="account-field">
            <label asp-for="Title"></label>
            <input asp-for="Title" maxlength="100" />
            <span asp-validation-for="Title" class="account-error"></span>
        </div>
        <div class="account-field">
            <label asp-for="Caption"></label>
            <input asp-for="Caption" maxlength="300" />
            <span asp-validation-for="Caption" class="account-error"></span>
        </div>
        <div class="account-field">
            <label asp-for="AltText"></label>
            <input asp-for="AltText" maxlength="200" placeholder="Le palais de Pristo, en cuivre oxydé et en bois" />
            <span class="carousel-hint">Lue par les lecteurs d'écran à la place de l'image.</span>
            <span asp-validation-for="AltText" class="account-error"></span>
        </div>
        <div class="carousel-admin-actions">
            <button type="submit" class="account-button">@(isEdit ? "Enregistrer" : "Ajouter l'image")</button>
            <a class="btn btn-ghost" asp-controller="Carousel" asp-action="Index">Annuler</a>
        </div>
    </form>
</section>
