@using Adelys_WebSite.ViewModels;
@model PlayerViewModel
@{
    ViewData["Title"] = "Les joueurs";
    <link rel="stylesheet" href="~/css/playersPage.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Shared/card.css" asp-append-version="true" />
}

<div class="">
    <article id="playersArticle">
        <section id="parliamentPlayers">
            @foreach (var player in Model.ParlementPlayers)
            {
                <div class="card cardPlayer">
                    <div class="card-body">
                        <h5 class="card-title">@player.Username</h5>
                        <div class="card-player-img-contener">
                            <img id="playerParlementImg_@player.Username" src="@player.SkinUrl" onerror="this.onerror=null;this.src='https://crafatar.com/renders/body/@player.Uuid'" class="cardPlayerImg" alt="Skin de @player.Username">
                        </div>
                        <h5 class="card-title">@player.Rank</h5>
                        <button class="btn-player-show-more">Voir plus</button>
                    </div>
                </div>
            }
        </section>
        <section id="otherPlayers">
            @foreach (var player in Model.OtherPlayers)
            {
                <div class="card cardPlayer">
                    <div class="card-body">
                        <h5 class="card-title">@player.Username</h5>
                        <div class="card-player-img-contener">
                            <img id="playerImg_@player.Username" src="@player.SkinUrl" onerror="this.onerror=null;this.src='https://crafatar.com/renders/body/@player.Uuid'" class="cardPlayerImg" alt="Skin de @player.Username">
                        </div>
                        <h5 class="card-title">@player.Rank</h5>
                        <button class="btn-player-show-more">Voir plus</button>
                    </div>
                </div>
            }
        </section>
    </article>
</div>
