@using Adelys_WebSite.BL;
@using Adelys_WebSite.ViewModels;
@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Changer de mot de passe";
    <link rel="stylesheet" href="~/css/account.css" asp-append-version="true" />
}

<section class="account-panel">
    <h1>Changer de mot de passe</h1>
    @if (User.HasClaim(c => c.Type == SiteUserBL.MustChangePasswordClaim))
    {
        <p>Choisis ton propre mot de passe pour terminer ta première connexion.</p>
    }
    <form asp-controller="Account" asp-action="ChangePassword" method="post">
        <div class="account-field">
            <label asp-for="CurrentPassword"></label>
            <input asp-for="CurrentPassword" autocomplete="current-password" autofocus />
            <span asp-validation-for="CurrentPassword" class="account-error"></span>
        </div>
        <div class="account-field">
            <label asp-for="NewPassword"></label>
            <input asp-for="NewPassword" autocomplete="new-password" />
            <span asp-validation-for="NewPassword" class="account-error"></span>
        </div>
        <div class="account-field">
            <label asp-for="ConfirmPassword"></label>
            <input asp-for="ConfirmPassword" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="account-error"></span>
        </div>
        <button type="submit" class="account-button">Enregistrer</button>
    </form>
</section>
