@{
    ViewData["Title"] = "Le règlement";
}
<div class="page">
    <h1 class="page-title">Le règlement</h1>
    <p class="page-lead">Les règles en vigueur sur le serveur.</p>
    <div class="split">
        <div class="split-list">
            <div class="card">
                <h2 class="card-title">Les lois</h2>
                <p class="card-text">Les règles communes à tous les joueurs</p>
                <a href="#" class="btn" onclick="loadLawsPage(); return false;">Afficher</a>
            </div>
            <div class="card">
                <h2 class="card-title">Les exceptions</h2>
                <p class="card-text">Les exploitations autorisées par joueur</p>
                <a href="#" class="btn" onclick="loadExceptionsPage(); return false;">Afficher</a>
            </div>
            <div class="card">
                <h2 class="card-title">Les usines</h2>
                <p class="card-text">Les règles des usines</p>
                <a href="#" class="btn" onclick="loadFactoriesPage(); return false;">Afficher</a>
            </div>
            <div class="card">
                <h2 class="card-title">Les monopoles</h2>
                <p class="card-text">Qui détient quelle ressource</p>
                <a href="#" class="btn" onclick="loadMonopoliesPage(); return false;">Afficher</a>
            </div>
        </div>
        <div class="panel split-content" id="displayInfo">
        </div>
    </div>
</div>

@section Scripts{
    <script src="~/js/rules.js"></script>
}
