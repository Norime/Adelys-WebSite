@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@model PlayerViewModel
@using Adelys_WebSite.ViewModels
@{
    ViewData["Title"] = "Adelys";
    <link rel="stylesheet" href="~/css/index.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/shared/carousel.css" asp-append-version="true" />
    <script src="~/js/home-index.js" asp-append-version="true"></script>
    <script src="~/js/carousel.js" asp-append-version="true"></script>
}
<div class="">
    <article class="index-article justify-content-center" id="article-banner">
        <div id="banner-welcome-message">
            <p>Bienvenue sur</p>
            <h1 class="website-name">Adelys</h1>
        </div>
        <div id="cover-picture">

            <div class="carousel">
                <div class="carousel-navigator">
                    <a class="carousel-navigator-arrow carousel-navigator-prev">
                        <i class="fas fa-angle-left"></i>
                        </a>
                    <a class="carousel-navigator-arrow carousel-navigator-next">
                        <i class="fas fa-angle-right"></i>
                    </a>
                </div>
                <ul class="slideshow">
                    <li class="slideshow-item">
                        <img src="/content/Images/PristoCity.png" class="carousel-custom-image" alt="...">
                        <div class="carousel-captions">
                            <h5>Pristo, un empire de confiance !</h5>
                            <p>Quoi de mieux que rejoindre l'empire le plus puissant ?'</p>
                        </div>
                    </li>
                    <li class="slideshow-item">
                        <img src="/content/Images/TestImage.png" class="carousel-custom-image" alt="...">
                        <div class="carousel-captions">
                            <h5>La gazette du sorc... Yonderred</h5>
                            <p>Du blabla sympa mais pas utile</p>
                        </div>
                    </li>
                    <li class="slideshow-item">
                        <img src="/content/Images/TestImage.png" class="carousel-custom-image" alt="...">
                        <div class="carousel-captions">
                            <h5>La cible parfaite</h5>
                            <p>Un problème ? Une erreur ? Dénoncer PiloteWho !</p>
                        </div>
                    </li>
                </ul>
                <div class="carousel-indicators">
                </div>
            </div>



