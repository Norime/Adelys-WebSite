@{
    ViewData["Title"] = "La gazette";
    <link rel="stylesheet" href="~/css/gazette.css" asp-append-version="true" />
}
<div class="page">
    <h1 class="page-title">La gazette</h1>
    <div class="split">
        <div class="split-list">
            <div class="card">
                <h2 class="card-title">Gazette de février 2023</h2>
            </div>
            <div class="card">
                <h2 class="card-title">Gazette spéciale Noël 2022</h2>
            </div>
            <div class="card">
                <h2 class="card-title">Gazette de novembre 2022</h2>
            </div>
        </div>
        <div class="panel" id="displayGazette">
            <embed src="content/Gazette/Gazette_26_02_2023.pdf" width="100%" height="100%" type="application/pdf" />
        </div>
    </div>
</div>
