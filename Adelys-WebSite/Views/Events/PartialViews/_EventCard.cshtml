@using Adelys_WebSite.BL;
@using Adelys_WebSite.ViewModels;
@model EventCardViewModel

<div class="event-card-wrapper">
    <a class="event-card @(Model.IsOver ? "is-over" : "")" asp-controller="Events" asp-action="Voir" asp-route-slug="@Model.Event.Slug">
        <div class="event-card-cover">
            @if (Model.Event.CoverFileName != null)
            {
                <img src="@(MarkdownBL.ImageRequestPath + Model.Event.CoverFileName)" alt="" loading="lazy" />
            }
            else
            {
                <i class="fa-solid fa-flag-checkered" aria-hidden="true"></i>
            }
            @if (Model.Event.IsFeatured && !Model.IsOver)
            {
                <span class="event-badge">À la une</span>
            }
        </div>
        <div class="event-card-body">
            <h3 class="event-card-title">@Model.Event.Title</h3>
            <p class="event-card-date">@EventDates.Format(Model.Event)</p>
            <p class="event-card-summary">@Model.Event.Summary</p>
        </div>
    </a>
    @if (Model.CanManage)
    {
        <div class="events-manage">
            <a asp-controller="Events" asp-action="Modifier" asp-route-slug="@Model.Event.Slug">Modifier</a>
            <form asp-controller="Events" asp-action="Supprimer" asp-route-slug="@Model.Event.Slug" method="post" onsubmit="return confirm('Supprimer définitivement cette édition et ses images ?');">
                <button type="submit">Supprimer</button>
            </form>
        </div>
    }
</div>
