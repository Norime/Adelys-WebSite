@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    string? adelysEventWebmap = Configuration["Webmaps:AdelysEvent"];
    string? currentController = ViewContext.RouteData.Values["controller"]?.ToString();
}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Adelys</title>
    <script>
        try {
            document.documentElement.dataset.palette = localStorage.getItem("adelys-palette") === "pierre" ? "pierre" : "nuit";
        } catch (e) {
            document.documentElement.dataset.palette = "nuit";
        }
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600&family=Saira+Condensed:wght@600;700&display=swap" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Shared/navbar.css" asp-append-version="true" />
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://kit.fontawesome.com/5bb4db790d.js" crossorigin="anonymous"></script>
</head>
<body>
    <header class="site-header">
        <nav class="site-nav">
            <div id="content-logo-title-navbar">
                <img src="/content/Images/LOGO_EUCRYPHIA.png" class="logo-website" alt="Logo Adelys" width="44" height="44" />
                <a id="title-navbar" class="no-underline" asp-area="" asp-controller="Home" asp-action="Index">Adelys</a>
            </div>
            <button class="navbar-toggler" type="button" aria-label="Ouvrir le menu" aria-expanded="false">&equiv;</button>
            <ul class="nav-links">
                <li class="nav-item">
                    <a class="nav-link no-underline @(currentController == "Home" ? "is-current" : "")" asp-area="" asp-controller="Home" asp-action="Index"><p class="nav-text">Accueil</p></a>
                </li>
                <li class="nav-item">
                    <a class="nav-link no-underline dropdown-toggle" asp-area="" asp-controller="" asp-action="" role="button" id="dropDownLink" data-bs-toggle="dropdown" aria-expanded="false"><p class="nav-text">WebMap</p></a>
                    <ul class="dropdown-menu" aria-labelledby="dropDownLink">
                        <li><a class="dropdown-item no-underline" href="@Configuration["Webmaps:Adelys"]" target="_blank"><p class="nav-text">Adelys</p></a></li>
                        @if (!string.IsNullOrEmpty(adelysEventWebmap))
                        {
                            <li><a class="dropdown-item no-underline" href="@adelysEventWebmap" target="_blank"><p class="nav-text">Adelys-Event</p></a></li>
                        }
                    </ul>
                </li>
                <li class="nav-item">
                    <a class="nav-link no-underline @(currentController == "Players" ? "is-current" : "")" asp-area="" asp-controller="Players" asp-action="Index"><p class="nav-text">Les joueurs</p></a>
                </li>
                <li class="nav-item">
                    <a class="nav-link no-underline @(currentController == "Shops" ? "is-current" : "")" asp-area="" asp-controller="Shops" asp-action="Index"><p class="nav-text">Les commerces</p></a>
                </li>
                <li class="nav-item">
                    <a class="nav-link no-underline @(currentController == "Gazette" ? "is-current" : "")" asp-area="" asp-controller="Gazette" asp-action="Index"><p class="nav-text">La gazette</p></a>
                </li>
                <li class="nav-item">
                    <a class="nav-link no-underline @(currentController == "Events" ? "is-current" : "")" asp-area="" asp-controller="Events" asp-action="Index"><p class="nav-text">Les events</p></a>
                </li>
                <li class="nav-item">
                    <a class="nav-link no-underline @(currentController == "Rules" ? "is-current" : "")" asp-area="" asp-controller="Rules" asp-action="Index"><p class="nav-text">Le règlement</p></a>
                </li>
                <li class="nav-item">
                    <a class="nav-link no-underline @(currentController == "ArchiveMaps" ? "is-current" : "")" asp-area="" asp-controller="ArchiveMaps" asp-action="Index"><p class="nav-text">Archives maps</p></a>
                </li>
            </ul>
            <div class="nav-tools">
                <button class="palette-toggle" type="button">
                    <span class="palette-swatch" aria-hidden="true"></span>
                    <span class="palette-label">Nuit</span>
                </button>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="nav-account-item">
                        <a class="nav-link no-underline dropdown-toggle" href="#" role="button" id="accountDropDownLink"><p class="nav-text">@User.Identity.Name</p></a>
                        <ul class="dropdown-menu" aria-labelledby="accountDropDownLink">
                            @if (User.IsInRole(SiteRoles.Admin))
                            {
                                <li><a class="dropdown-item no-underline" asp-area="" asp-controller="Users" asp-action="Index"><p class="nav-text">Utilisateurs</p></a></li>
                            }
                            <li><a class="dropdown-item no-underline" asp-area="" asp-controller="Account" asp-action="ChangePassword"><p class="nav-text">Mot de passe</p></a></li>
                            <li>
                                <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="dropdown-item nav-button"><p class="nav-text">Déconnexion</p></button>
                                </form>
                            </li>
                        </ul>
                    </div>
                }
                else
                {
                    <a class="nav-login no-underline" asp-area="" asp-controller="Account" asp-action="Login">Connexion</a>
                }
            </div>
        </nav>
    </header>
    <main role="main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        &copy; @DateTime.Now.Year Adelys, serveur Minecraft entre amis
    </footer>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/navbar.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
