<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Adelys_WebSite</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Shared/navbar.css" asp-append-version="true" />
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://kit.fontawesome.com/5bb4db790d.js" crossorigin="anonymous"></script>
</head>
<body>
    <header>
        <nav>
            <div id="content-logo-title-navbar">
                <img src="/content/Images/LOGO_EUCRYPHIA.png" class="logo-website" alt="Logo Adelys" height="30" />
                <a id="title-navbar" class="no-underline" asp-area="" asp-controller="Home" asp-action="Index">Adelys</a>
            </div>
            <button class="navbar-toggler" onclick="openNavbarMenu()">
                <span class="navbar-toggler-icon">&equiv;</span>
            </button>
            <ul class="nav-links">
                <li class="nav-item">
                    <a class="nav-link no-underline" asp-area="" asp-controller="Home" asp-action="Index"><p class="nav-text">Accueil</p></a>
                </li>
                <li class="nav-item">
                    <a class="nav-link no-underline dropdown-toggle" asp-area="" asp-controller="" asp-action="" role="button" id="dropDownLink" data-bs-toggle="dropdown" aria-expanded="false"><p class="nav-text">WebMap</p></a>
                    <ul class="dropdown-menu" aria-labelledby="dropDownLink">
                        <li><a class="dropdown-item no-underline" href="@Environment.GetEnvironmentVariable("ADELYS_WEBMAP")" target="_blank"><p class="nav-text">Adelys</p></a></li>
                        <li><a class="dropdown-item no-underline" href="@Environment.GetEnvironmentVariable("ADELYS_EVENT_WEBMAP")" target="_blank"><p class="nav-text">Adelys-Event</p></a></li>
                    </ul>
                </li>
                <li class="nav-item">
                    <a class="nav-link no-underline" asp-area="" asp-controller="Players" asp-action="Index"><p class="nav-text">Les joueurs</p></a>
                </li>
                <li class="nav-item">
                    <a class="nav-link no-underline" asp-area="" asp-controller="Shops" asp-action="Index"><p class="nav-text">Les commerces</p></a>
                </li>
                <li class="nav-item">
                    <a class="nav-link no-underline" asp-area="" asp-controller="Gazette" asp-action="Index"><p class="nav-text">La gazette</p></a>
                </li>
                <li class="nav-item">
                    <a class="nav-link no-underline" asp-area="" asp-controller="Rules" asp-action="Index"><p class="nav-text">Le réglement</p></a>
                </li>
                <li class="nav-item">
                    <a class="nav-link no-underline" asp-area="" asp-controller="ArchiveMaps" asp-action="Index"><p class="nav-text">Archives maps</p></a>
                </li>
            </ul>
        </nav>
        @* <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light box-shadow">
            <div class="container-fluid">
                <div id="content-logo-title-navbar">
                    <img src="/content/Images/LOGO_EUCRYPHIA.png" class="d-block" id="logo-navbar" alt="...">
                    <a class="navbar-brand" id="title-navbar" asp-area="" asp-controller="Home" asp-action="Index">Adelys</a>
                </div>
                
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link nav-text" asp-area="" asp-controller="Home" asp-action="Index">Accueil</a>
                        </li>
                        <li class="nav-item nav-text dropdown">
                            <a class="nav-link dropdown-toggle" asp-area="" asp-controller="Home" asp-action="" data-bs-toggle="dropdown">WebMap</a>
                            <div class="dropdown-menu">
                                <a class="dropdown-item" href=@Environment.GetEnvironmentVariable("ADELYS_WEBMAP")>Adelys</a>
                                <a class="dropdown-item" href="@Environment.GetEnvironmentVariable("ADELYS_EVENT_WEBMAP")">Adelys-Event</a>
                            </div>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-text" asp-area="" asp-controller="Players" asp-action="">Les joueurs</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-text" asp-area="" asp-controller="Shops" asp-action="">Les commerces</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-text" asp-area="" asp-controller="Gazette" asp-action="">La gazette</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-text" asp-area="" asp-controller="Rules" asp-action="">Réglement</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-text" asp-area="" asp-controller="ArchiveMaps" asp-action="">Archives maps</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav> *@
    </header>
    <main role="main" class="">
        @RenderBody()
    </main>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2023 - Adelys_WebSite - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/navbar.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
