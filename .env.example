# Copier en .env sur le Pi et remplir. Ce fichier contient des mots de passe : il n'est jamais envoyé sur GitHub.

# Base du site (comptes, gazette, commerces, règlement, events, carrousel)
ConnectionStrings__Site=Server=ADRESSE_MYSQL;Port=3306;Database=NOM_BASE_SITE;User=UTILISATEUR;Password=MOT_DE_PASSE

# Base LuckPerms, lue seulement (joueurs et rangs)
ConnectionStrings__Luckperms=Server=ADRESSE_MYSQL;Port=3306;Database=NOM_BASE_LUCKPERMS;User=UTILISATEUR;Password=MOT_DE_PASSE

# Carte BlueMap servie en HTTPS par le tunnel (voir cloudflared/config.yml)
Webmaps__Adelys=https://map.eucryphia.fr/

# Adresse du serveur Minecraft, pour suivre sa version (facultatif)
Minecraft__ServerAddress=
